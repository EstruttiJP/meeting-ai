# =============================================================================
# Meeting AI — variáveis de ambiente
# =============================================================================
#
# Copie para `.env` (`cp .env.example .env`) e preencha o que for necessário.
# O `.env` é gitignorado — nunca commite segredos reais, nem "temporariamente".
#
# COMO LER ESTE ARQUIVO
#
#   [obrigatória]  sem isso a funcionalidade não sobe ou não funciona
#   [opcional]     tem default sensato; só preencha para mudar o comportamento
#
# Toda variável abaixo mostra o valor usado quando ela fica ausente. Deixar em
# branco (`FOO=`) NÃO é o mesmo que omitir: o Compose repassa string vazia e o
# default do Spring não entra. Se não for usar, comente a linha ou apague.
#
# ONDE CADA UMA É LIDA
#
#   docker-compose.yml ......... infra (Postgres, LocalStack, Whisper, CORS)
#   application.properties ..... backend, via `${VAR:default}`
#
# Uma variável só chega ao backend se o docker-compose.yml a repassar no bloco
# `environment:` do serviço `backend`. Todas as listadas aqui já estão
# repassadas — ao adicionar uma nova, lembre de incluí-la lá também, senão
# defini-la aqui não terá efeito nenhum.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Postgres                                                          [opcional]
# -----------------------------------------------------------------------------
# Credenciais do banco local. O Compose monta a SPRING_DATASOURCE_URL do backend
# a partir de POSTGRES_DB, então mudar o nome aqui basta — não existe URL de
# banco para editar à mão.
#
# Trocar usuário/senha com o volume já criado NÃO funciona: o Postgres só aplica
# essas variáveis na primeira inicialização, quando cria o data dir. Para valer,
# derrube o volume antes (`docker compose down -v`, apaga os dados).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meetingai


# -----------------------------------------------------------------------------
# LocalStack — AWS falsa para desenvolvimento local                  [opcional]
# -----------------------------------------------------------------------------
# LOCALSTACK_DEBUG=1 despeja cada chamada AWS no log do container. Útil quando o
# upload falha sem mensagem clara; ruidoso no dia a dia.
LOCALSTACK_DEBUG=0
S3_BUCKET_NAME=meeting-ai-recordings
SQS_QUEUE_NAME=meeting-ai-processing

# Credenciais fake: o LocalStack aceita qualquer valor, não valida nada. Só
# precisam existir porque o SDK da AWS recusa subir sem credencial nenhuma.
# Ao apontar para uma AWS real, troque por credenciais de verdade — e revise
# antes se o resto do projeto está pronto para isso.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1


# -----------------------------------------------------------------------------
# Whisper — transcrição local                                        [opcional]
# -----------------------------------------------------------------------------
# Modelo do serviço de transcrição (roda em CPU, sem chamar API externa).
# Quanto maior, melhor a transcrição e mais lenta e pesada ela fica:
#
#   tiny .... mais rápido, erra bastante nome próprio e número
#   base .... default; equilíbrio razoável para desenvolvimento
#   small ... visivelmente melhor em português, ~2x mais lento que base
#   medium .. bem melhor, pede bastante RAM e paciência
#   large ... melhor qualidade, inviável em CPU para arquivo longo
#
# Trocar o valor exige recriar o container (`docker compose up -d --force-recreate
# whisper`); o modelo novo é baixado na primeira execução, então a primeira
# transcrição depois da troca demora mais.
WHISPER_MODEL=base

# A URL do Whisper NÃO fica aqui: o Compose já aponta o backend para
# http://whisper:9000 pela rede interna. Só existe WHISPER_BASE_URL para rodar
# o backend fora do Compose (default http://localhost:9000).


# -----------------------------------------------------------------------------
# Frontend                                                           [opcional]
# -----------------------------------------------------------------------------
# Usada em dois lugares no backend: origem liberada no CORS e destino do
# redirect pós-login do Google. Se o Angular subir em outra porta, mude aqui —
# senão o login termina redirecionando para o lugar errado e as chamadas da API
# passam a ser barradas por CORS.
FRONTEND_URL=http://localhost:4200


# -----------------------------------------------------------------------------
# Google OAuth2 — login da aplicação                              [obrigatória]
# -----------------------------------------------------------------------------
# Sem isso não existe login, e como toda rota /api/** exige sessão autenticada,
# o produto inteiro fica inacessível. O backend sobe assim mesmo (cai num
# placeholder de dev), mas qualquer tentativa de login falha no Google.
#
# Onde obter: Google Cloud Console > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application.
#
# Configure lá, exatamente:
#   Authorized JavaScript origins ..... http://localhost:4200
#   Authorized redirect URIs .......... http://localhost:8080/login/oauth2/code/google
#
# O redirect aponta para o BACKEND (8080), não para o frontend — quem troca o
# código pelo token é o Spring Security. Errar essa URI dá redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Criptografia de segredos em banco                               [obrigatória]
# -----------------------------------------------------------------------------
# Protege, em repouso, a chave de IA que o usuário cola nas Configurações e os
# tokens OAuth do Pipedrive. Nunca são gravados em texto puro.
#
# Ausentes, o backend usa um placeholder de desenvolvimento que está commitado
# no application.properties — ou seja, público. Serve para subir o projeto e
# clicar em volta; não serve para guardar credencial de ninguém.
#
# Gere valores próprios por ambiente (nunca reaproveite entre ambientes):
#   APP_ENCRYPTION_KEY ..... openssl rand -base64 32
#   APP_ENCRYPTION_SALT .... openssl rand -hex 16   (precisa ser hexadecimal)
#
# ATENÇÃO: trocar a chave ou o salt torna ilegível tudo que já foi criptografado
# com os valores antigos. Os usuários precisarão colar a chave de IA de novo e
# reconectar o CRM. Não rotacione sem planejar a migração dos dados existentes.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_SALT=


# -----------------------------------------------------------------------------
# OpenRouter — provider de IA padrão da aplicação                 [obrigatória]
# -----------------------------------------------------------------------------
# Gera o resumo estruturado para quem não configurou chave própria. Sem ela, a
# transcrição funciona e o resumo falha — a reunião termina em FAILED com o
# motivo técnico gravado em meeting.failure_reason.
#
# A chave própria do usuário (Gemini/GPT/Claude) NÃO entra aqui: fica no banco,
# criptografada, configurada por cada um na tela de Configurações.
#
# Onde obter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [opcional] Sobrescreve o modelo. Default: openai/gpt-oss-20b:free
#
# Os modelos `:free` entram e saem do catálogo do OpenRouter sem aviso. Se o
# resumo começar a falhar com "modelo não encontrado" ou 404, confira a lista
# atual em https://openrouter.ai/api/v1/models antes de suspeitar do código.
#
# Modelo free costuma ser lento: em teste real, uma reunião de ~2 min levou de
# 1 a 9 minutos para resumir, variando com a fila do provider.
#OPENROUTER_MODEL=

# [opcional] Default: https://openrouter.ai/api/v1
#OPENROUTER_BASE_URL=


# -----------------------------------------------------------------------------
# Modelos dos providers de chave própria                             [opcional]
# -----------------------------------------------------------------------------
# Só afetam quem configurou chave própria nas Configurações. A CHAVE de cada um
# não vem daqui — vem do banco, criptografada, por usuário.
#
# GEMINI_MODEL ..... default gemini-1.5-flash
# OPENAI_MODEL ..... default gpt-4o-mini
# CLAUDE_MODEL ..... default claude-3-5-haiku-20241022
#GEMINI_MODEL=
#OPENAI_MODEL=
#CLAUDE_MODEL=


# -----------------------------------------------------------------------------
# Pipedrive OAuth — envio do resumo ao CRM                           [opcional]
# -----------------------------------------------------------------------------
# Sem isso o produto funciona inteiro (upload, transcrição, resumo, revisão);
# só o botão "Enviar ao CRM" não tem para onde enviar.
#
# Onde obter: Pipedrive > Configurações > Apps privados > criar app.
#
# O client_id também precisa ser copiado À MÃO para
# frontend/src/environments/environment.ts (campo `pipedrive.clientId`): o
# Angular é compilado no navegador e não lê este arquivo. Sem o valor lá, o
# botão "Conectar Pipedrive" da tela de Configurações fica escondido, mesmo com
# tudo certo aqui. O client_id é público por natureza; só o secret é sensível e
# fica exclusivamente no backend.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# Precisa bater exatamente com o callback registrado no app do Pipedrive.
PIPEDRIVE_REDIRECT_URI=http://localhost:4200/settings


# -----------------------------------------------------------------------------
# Limites e retenção                                                 [opcional]
# -----------------------------------------------------------------------------
# Dias que o áudio bruto sobrevive. O prazo conta a partir do upload, não do fim
# do pipeline — uma reunião travada em TRANSCRIBING expira junto. Vencido o
# prazo, o job apaga o arquivo e marca a reunião como EXPIRED; o resumo em texto
# permanece no banco, mas o player da tela de revisão deixa de funcionar (a tela
# explica o motivo).
# Default: 7
#MEETING_RETENTION_DAYS=

# Tamanho máximo do upload, em MB. Validado antes de consumir cota ou gravar
# qualquer byte em disco. Acima disso, o upload é recusado com 413.
# Default: 200
#MEETING_MAX_FILE_SIZE_MB=

# Cron (formato Spring, com campo de segundos) do job que expira reuniões.
# Default: 0 0 * * * *  — de hora em hora, no minuto zero.
#MEETING_EXPIRATION_CRON=

# Uploads por usuário por mês. A cota é criada no primeiro acesso com este
# limite; alterar o valor NÃO atualiza cotas já criadas no banco.
# Default: 10
#USAGE_QUOTA_DEFAULT_MONTHLY_LIMIT=
