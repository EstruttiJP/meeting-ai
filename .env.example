# Copy this file to .env and adjust as needed. .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meetingai

# --- LocalStack (fake AWS for local dev) ---
LOCALSTACK_DEBUG=0
S3_BUCKET_NAME=meeting-ai-recordings
SQS_QUEUE_NAME=meeting-ai-processing

# --- AWS credentials (dummy values, LocalStack does not validate them) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# --- Frontend ---
FRONTEND_URL=http://localhost:4200

# --- Google OAuth2 (Google Cloud Console > Credentials > OAuth client ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Criptografia de segredos em banco (chave própria de IA, tokens do CRM) ---
# Gere valores próprios em cada ambiente real — nunca reutilize o default de dev.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_SALT=

# --- OpenRouter (provider de IA padrão da aplicação, plano free) ---
# Chave própria do usuário (Gemini/GPT/Claude) não entra aqui — fica no banco,
# criptografada, configurada por cada usuário em Configurações.
OPENROUTER_API_KEY=

# Opcional: sobrescreve o modelo free padrão (openai/gpt-oss-20b:free). Os
# modelos :free entram e saem do catálogo do OpenRouter — se o resumo começar a
# falhar com "modelo não encontrado", confira a lista atual em
# https://openrouter.ai/api/v1/models antes de suspeitar do código.
OPENROUTER_MODEL=

# --- Pipedrive OAuth (Pipedrive > Configurações > Apps privados) ---
# O mesmo client_id (é público, só o secret fica sensível) também precisa
# ser copiado manualmente para frontend/src/environments/environment.ts
# (pipedrive.clientId) — o Angular não lê esse .env, e sem o valor lá o
# botão "Conectar Pipedrive" da tela de Configurações fica escondido.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://localhost:4200/settings
