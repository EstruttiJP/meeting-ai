FROM node:22-alpine

WORKDIR /app

# Cache npm install in its own layer; the bind mount at runtime overlays
# the source (but not node_modules, see docker-compose.yml volumes).
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 4200

# --poll is required for live reload to work reliably: Docker Desktop's
# bind-mount filesystem (osxfs/gRPC-FUSE, WSL2 9p) does not forward inotify
# events, so Vite's native watcher never fires without polling.
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--poll", "1000"]
